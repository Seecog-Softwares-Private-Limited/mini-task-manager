# Production overrides for repo-root properties.env on the Hostinger VPS.
# Merge into /root/projects/mini-task-manager/properties.env on the server.
# Do NOT commit real secrets to git if you can avoid it.

NODE_ENV=production
APP_MODE=production

# Hostinger local MySQL (imported dump)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD="Pankaj12345##"
DB_DATABASE=mini_task_manager

# Ports: API 3007, frontend 3000 (nginx may also proxy :80 → :3000)
# CRITICAL: MINI_TM_BACKEND_URL must be loopback Nest — never http://THIS_HOST:3000
# (that makes app.js skip Nest and Next proxies to itself → login/API 503).
PORT=3007
FRONTEND_PORT=3000
MINI_TM_BACKEND_URL=http://127.0.0.1:3007

# Production URLs (Hostinger VPS)
# PUBLIC_API_URL is the public browser/mobile origin (Next). It must NOT be used
# as MINI_TM_BACKEND_URL on this host.
FRONTEND_URL_PRODUCTION=http://200.97.172.61:3000
CORS_ORIGIN_PRODUCTION=http://200.97.172.61:3000
PUBLIC_API_URL=http://200.97.172.61:3000

# Historical AWS Lightsail (reference only)
# FRONTEND_URL_PRODUCTION=http://3.110.214.243:3000
# CORS_ORIGIN_PRODUCTION=http://3.110.214.243:3000

# ── Firebase Admin (REQUIRED for Android/iOS push) ─────────────────────────
# Device token registration works without this; FCM delivery does NOT.
# The JSON is gitignored — copy it onto the VPS manually:
#   scp config/firebase-service-account.json root@HOST:/root/projects/mini-task-manager/config/
# Then either keep the relative path (resolved from repo root) or set absolute:
FIREBASE_SERVICE_ACCOUNT_PATH=config/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"mini-task-manager-1879d",...}
#
# iOS also needs an APNs Auth Key (.p8) uploaded in Firebase Console →
# Project settings → Cloud Messaging → Apple app.
#
# Verify after restart: GET /health → push.firebaseAdminReady must be true

# After editing properties.env on the server:
#   pm2 restart mini-task-manager --update-env
#   pm2 save
