# Production overrides for repo-root properties.env on the server.
# Copy relevant lines into /home/bitnami/projects/mini-task-manager/properties.env
# (or merge with your existing production file). Do NOT commit real secrets to git.

NODE_ENV=production
APP_MODE=production

# Production URLs (active when APP_MODE=production)
FRONTEND_URL_PRODUCTION=http://3.110.214.243:3000
CORS_ORIGIN_PRODUCTION=http://3.110.214.243:3000

# Local URLs (keep for reference when developing on the same file)
# FRONTEND_URL_LOCAL=http://localhost:3008
# CORS_ORIGIN_LOCAL=http://localhost:3008

# Backend listen port (API). Frontend is served separately (e.g. PM2 mini-frontend on :3000).
# PORT=3007
# FRONTEND_PORT=3000

# Required for Next.js /api/v1 proxy → Nest (set on the frontend PM2 process):
# MINI_TM_BACKEND_URL=http://127.0.0.1:3007

# After editing properties.env on the server, restart the API process:
#   pm2 restart <api-process-name>
#   pm2 save
