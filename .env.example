# =============================================================================
# SMTP - Email delivery for invitations
# =============================================================================
# Default (localhost:1025) uses MailHog - emails are captured locally, NOT sent
# to real inboxes. View them at http://localhost:8025 if MailHog is running.
#
# To send to real Gmail inboxes, set:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=your-email@gmail.com
#
# Gmail App Password: Google Account → Security → 2-Step Verification → App passwords
# =============================================================================

# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@minitaskmanager.local

# Gmail example (uncomment and fill):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# SMTP_FROM=your-email@gmail.com
