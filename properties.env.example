# Copy to properties.env and fill in your values.
# This project does not use .env, .env.local, or .env.* — only repo-root properties.env.
# Backend, migrations, seeds, Next (dev/build), Cypress, and docker-compose (backend) use this file.

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=mini_task_manager

# App
JWT_SECRET=replace-with-your-secret

# Ports (defaults: backend 3000, frontend 3001). Frontend uses PORT for API URL.
PORT=3000
FRONTEND_PORT=3001

# Optional: override API URL only if needed (e.g. different host). Otherwise PORT above is used.
# NEXT_PUBLIC_API_URL=http://localhost:3000
# Optional: for redirects, CORS, callbacks when using non-default ports
# FRONTEND_URL=http://localhost:3001
# CORS_ORIGIN=http://localhost:3001

# Optional: seed overrides
# SEED_USER_PASSWORD=YourStrongPassword123!
# SEED_INVITED_EMAIL=invitee@example.com

# Razorpay (billing — POST /billing/create-order)
# Without valid Test/Live keys, checkout fails. Get keys: https://dashboard.razorpay.com/app/keys
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxx

# ── SMTP (invitations) ─────────────────────────────────────────────────────
# Default localhost:1025 = MailHog; view mail at http://localhost:8025
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@minitaskmanager.local
#
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=your-email@gmail.com

# ── Google OAuth (optional) ────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# ── Cypress (optional, e2e) ───────────────────────────────────────────────
# CYPRESS_BASE_URL=http://localhost:3001
# CYPRESS_API_URL=http://localhost:3000/api/v1
# CYPRESS_TEST_USER_EMAIL=owner@example.com
# CYPRESS_TEST_USER_PASSWORD=Password123!
