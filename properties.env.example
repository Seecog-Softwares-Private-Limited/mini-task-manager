# Copy to properties.env and fill in your values.
# This project does not use .env, .env.local, or .env.* — only repo-root properties.env.
# Backend, migrations, seeds, Next (dev/build), Cypress, and docker-compose (backend) use this file.

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=mini_task_manager

# App
JWT_SECRET=replace-with-your-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Ports (defaults: backend 3000, frontend 3001). Frontend uses PORT for API URL.
PORT=3000
FRONTEND_PORT=3001

# Switch environment: development (local) | production (server)
APP_MODE=development

# Local dev URLs (used when APP_MODE=development)
FRONTEND_URL_LOCAL=http://localhost:3001
CORS_ORIGIN_LOCAL=http://localhost:3001

# Production URLs (REQUIRED on server — invite emails use this for Accept Invitation button)
# On AWS/Lightsail: APP_MODE=production and set your public app URL (not localhost).
FRONTEND_URL_PRODUCTION=http://3.110.214.243:3000
CORS_ORIGIN_PRODUCTION=http://3.110.214.243:3000

# Public Nest API URL (no /api/v1 suffix). Fallback for invite links if FRONTEND_URL_PRODUCTION is unset.
PUBLIC_API_URL=http://3.110.214.243:3007

# Optional: override API URL only if needed (e.g. different host). Otherwise PORT above is used.
# NEXT_PUBLIC_API_URL=http://localhost:3000

# Email verification on signup (default: send verification email). Set true to skip for local/testing.
# SKIP_EMAIL_VERIFICATION=false
# Require verified email before login (production). Default: login succeeds and auto-verifies.
# REQUIRE_EMAIL_VERIFIED_FOR_LOGIN=false

# Optional: seed overrides
# SEED_USER_PASSWORD=YourStrongPassword123!
# SEED_INVITED_EMAIL=invitee@example.com

# Razorpay (billing — POST /billing/create-order)
# Without valid Test/Live keys, checkout fails. Get keys: https://dashboard.razorpay.com/app/keys
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxx

# ── SMTP (signup verification, invitations, password reset) ───────────────
#
# Option A — Gmail (real delivery to inboxes)
# 1. Enable 2-Step Verification on the Google account
# 2. Create an App Password: Google Account → Security → App passwords
# 3. Use the 16-character app password as SMTP_PASS (not your normal Gmail password)
# Remove duplicate FRONTEND_URL line below if you use APP_MODE + *_LOCAL / *_PRODUCTION above.
# FRONTEND_URL=http://localhost:3001
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
# Use the same domain as SMTP_USER for better deliverability (SPF/DKIM in Google Admin).
SMTP_FROM="OpsPick <noreply@opspick.com>"
#
# Option B — MailHog (local capture only, no real delivery)
# docker compose up -d mailhog  →  view mail at http://localhost:8025
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@opspick.com
#
# SMTP_VERIFY_ON_STARTUP=true

# ── Firebase Admin (push notifications via FCM) ───────────────────────────
# Required on the Nest host for server → device pushes. Client google-services /
# GoogleService-Info.plist alone are not enough.
#
# Option A — file (gitignored). See config/README.md
# Place JSON at: config/firebase-service-account.json
#
# Option B — env path or raw JSON
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
#
# APNs Auth Key (.p8) is configured in Firebase Console → Project settings →
# Cloud Messaging → Apple app (not stored in this repo).

# ── Google OAuth (optional) ────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# ── Cypress (optional, e2e) ───────────────────────────────────────────────
# CYPRESS_BASE_URL=http://localhost:3001
# CYPRESS_API_URL=http://localhost:3000/api/v1
# CYPRESS_TEST_USER_EMAIL=owner@example.com
# CYPRESS_TEST_USER_PASSWORD=Password123!
