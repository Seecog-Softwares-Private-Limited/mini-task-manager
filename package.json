{
  "name": "mini-task-manager",
  "version": "1.0.0",
  "description": "Task Manager SaaS - Production-grade NestJS backend",
  "scripts": {
    "build": "nest build",
    "build:frontend": "cd frontend && npm run build",
    "build:all": "npm run build && npm run build:frontend",
    "pm2:start": "node -e \"require('fs').mkdirSync('logs',{recursive:true})\" && npx pm2 start ecosystem.config.cjs",
    "pm2:stop": "npx pm2 stop ecosystem.config.cjs",
    "pm2:restart": "npx pm2 restart ecosystem.config.cjs",
    "pm2:delete": "npx pm2 delete ecosystem.config.cjs",
    "pm2:logs": "npx pm2 logs",
    "pm2:status": "npx pm2 status",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "prestart:prod": "npm run build",
    "start:prod": "node dist/main",
    "start:app": "node app.js",
    "start:app:dev": "cross-env APP_MODE=development node app.js",
    "start:app:prod": "cross-env APP_MODE=production node app.js",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:run": "npm run typeorm -- migration:run -d src/infrastructure/database/data-source.ts",
    "db:ensure-project-icon-url": "npx ts-node -r tsconfig-paths/register src/infrastructure/database/ensure-project-icon-url-column.ts",
    "test": "jest",
    "test:security": "jest --testPathPattern=security-integration",
    "test:throttle": "jest --testPathPattern=throttle-integration --runInBand",
    "seed": "npx ts-node -r tsconfig-paths/register src/infrastructure/database/seed/run-seed.ts",
    "seed:add-admin": "npx ts-node -r tsconfig-paths/register src/infrastructure/database/seed/add-admin.ts",
    "seed:add-invited-user": "npx ts-node -r tsconfig-paths/register src/infrastructure/database/seed/add-invited-user.ts",
    "seed:personal-solutions-members": "npx ts-node -r tsconfig-paths/register src/infrastructure/database/seed/seed-personal-solutions-members.ts",
    "seed:fix-login": "npx ts-node -r tsconfig-paths/register src/infrastructure/database/seed/fix-seed-users-login.ts",
    "dev": "concurrently -n api,web -c blue,green \"npm run start:dev\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/terminus": "^10.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.0",
    "bcrypt": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.5",
    "mysql2": "^3.6.0",
    "nodemailer": "^8.0.1",
    "passport": "^0.6.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "razorpay": "^2.9.4",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "twilio": "^5.12.2",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.4.22",
    "@types/bcrypt": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^7.0.10",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^3.0.13",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "jest": "^30.2.0",
    "pm2": "^5.4.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  }
}
