# Local dev URLs (used when APP_MODE=development)
FRONTEND_URL_LOCAL=http://localhost:3008
CORS_ORIGIN_LOCAL=http://localhost:3008

# Production URLs (used when APP_MODE=production or NODE_ENV=production)
